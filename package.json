{
	"name": "better-notes",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "electron/main.js",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
		"dev:electron": "concurrently \"npm run dev\" \"npm run electron\""
	},
	"dependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.0",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@vitejs/plugin-react": "^4.4.1",
		"concurrently": "^9.1.2",
		"cross-env": "^7.0.3",
		"electron": "^36.4.0",
		"eslint": "^9.25.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"globals": "^16.0.0",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.30.1",
		"vite": "^6.3.5",
		"wait-on": "^8.0.3"
	}
}